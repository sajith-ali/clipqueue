{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipQueue",
  "version": "0.1.0",
  "identifier": "dev.clipqueue.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipQueue",
        "width": 960,
        "height": 760,
        "minWidth": 560,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "publisher": "ClipQueue",
    "category": "Utility",
    "shortDescription": "Queue and download videos",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}